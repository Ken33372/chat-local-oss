# 可选：复制为 .env 后手动配置；环境变量优先于页面向导保存的 data/config.json。
# 不要提交真实密钥。

# ---------------- 方式一：DeepSeek 一键 ----------------
# 填了这一项，后端会自动把 LLM、ASR、OCR 指向 DeepSeek。
# 云端模式（前端直连）仍然在页面里单独填 API Key，不需要这个变量。
DEEPSEEK_API_KEY=

# ---------------- 方式二：逐项配置 ----------------
# LLM：任意 Anthropic 兼容接口（DeepSeek、其他网关或自建服务）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 自定义模型的输入/输出上限（tokens）
LLM_CONTEXT_LIMIT=131072
LLM_MAX_OUTPUT_TOKENS=8192

# ASR：none | deepseek | openai
ASR_PROVIDER=none
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# 地址填服务根地址会自动接 /v1/audio/transcriptions；填完整地址（如自建的 /transcribe）就原样请求

# OCR：none | deepseek | openai
# deepseek 支持 PDF/Word/PPT/图片；openai 兼容接口只支持图片
OCR_PROVIDER=none
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=gpt-4o-mini

# 搜索：none | tavily | anysearch | searxng
# anysearch 的 key 可留空（匿名限流）；tavily 需要 key；searxng 需要填自建地址
SEARCH_PROVIDER=none
SEARCH_BASE_URL=
SEARCH_API_KEY=
SEARCH_RESULTS=6

# 重排（可选）：OpenAI 兼容的 /v1/rerank 接口，如 llama-server --reranking、
# HuggingFace text-embeddings-inference。SearXNG 只出标题和摘要，
# 配了重排才会翻页聚合候选再按相关性挑前 SEARCH_RESULTS 条；不配就只取一页。
# 这三项也可以在首次运行向导里填（搜索选 searxng 时会多出一组输入框）。
RERANK_PROVIDER=none
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=20
# 根地址自动接 /v1/rerank；填完整地址（TEI 的 /rerank）原样请求。响应认 results 包装和顶层数组两种形状

# 朗读（可选）：none | deepseek | openai | engine | template
# - deepseek：官方 /v1/tools/tts，key 可直接用上面的 DEEPSEEK_API_KEY
# - openai：OpenAI 兼容 /v1/audio/speech。llama.cpp / audio.cpp / vLLM / TGI / Kokoro-FastAPI
#   和多数套壳 fork 都是这个形状
# - engine：用 engine 字段选模型的那一类推理服务（{engine, input, voice, response_format}），
#   地址要填到接口级，原样请求
# - template：完全自定义，见下面 TTS_TEMPLATE_*，用来接"自己用 FastAPI 包了一层"的服务
# 这几项也可以在首次运行向导里填（高级 → 朗读，template 只能写在这里）。不配就没有朗读按钮。
TTS_PROVIDER=none
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
# 音色名由服务自己定义，留空用默认（DeepSeek：stella；OpenAI：alloy）；engine 模式必填
TTS_VOICE=
# 返回容器：wav / mp3 / opus / pcm，前三种带容器头，浏览器能自己判采样率
TTS_RESPONSE_FORMAT=wav
# 单次请求的字数上限，长回复按句子边界切段后逐段合成
TTS_MAX_CHARS=4000

# template 模式专用（其他 provider 不读这几项）
# TTS_TEMPLATE_URL：完整接口地址；留空则用 TTS_BASE_URL
# TTS_TEMPLATE_BODY：请求体 JSON 模板，可用 {text} {voice} {model} {format} 占位
# TTS_TEMPLATE_AUDIO：音频怎么取——body（响应体就是音频，默认）/
#                     base64:<字段路径>（JSON 里某字段是 base64 音频）/
#                     url:<字段路径>（JSON 里某字段是音频链接，再去下载）
# TTS_TEMPLATE_HEADERS：追加/覆盖请求头的 JSON，值里可用 {key} 引用 TTS_API_KEY
TTS_TEMPLATE_URL=
TTS_TEMPLATE_BODY={"input": "{text}", "voice": "{voice}", "response_format": "{format}"}
TTS_TEMPLATE_AUDIO=body
TTS_TEMPLATE_HEADERS=

# 搜索进阶（仅 searxng 这一路生效，一般不用改）
# SEARCH_CANDIDATE_TARGET：攒够这么多候选就停止翻页
# SEARCH_CANDIDATE_MAX：送进重排的候选上限
# SEARCH_MAX_PAGES：最多翻几页
# SEARCH_SNIPPET_CHARS：每条摘要的截断长度
SEARCH_CANDIDATE_TARGET=20
SEARCH_CANDIDATE_MAX=60
SEARCH_MAX_PAGES=5
SEARCH_SNIPPET_CHARS=500
# 站点规则，逗号分隔：写 example.com 连子域一起算，写 example.com/docs 再限定路径前缀
SEARCH_ALLOWED_DOMAINS=
SEARCH_BLOCKED_DOMAINS=

# 可选
CHAT_LOCAL_HOST=127.0.0.1
CHAT_LOCAL_PORT=17865
CHAT_LOCAL_IMAGE_MODE=vision
CHAT_LOCAL_MAX_TOOL_ROUNDS=5
